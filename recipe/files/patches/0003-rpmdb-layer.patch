+++ b/rpm/rpmdb/rpmdb.bzl
@@ -0,0 +1,50 @@
+"""ReadyStack: an RPM database layer for an rpmtree image.
+
+bazeldnf's rpm2tar unpacks RPM payloads but writes no RPM database, so a scanner reading the image sees none of the
+packages it carries. rpmdb() records exactly the given RPMs in /var/lib/rpm/rpmdb.sqlite (rpm --justdb: headers
+only, no payload, no scriptlets) and emits it as a tar layer. INSTALLTIME and INSTALLTID come from SOURCE_DATE_EPOCH
+(rpm 4.16 honours it), the tar is sorted with fixed owners, modes and mtimes, so the layer is the same on every build.
+It is metadata only: nothing KubeVirt executes reads it.
+"""
+
+def _rpmdb_impl(ctx):
+    out = ctx.actions.declare_file(ctx.label.name + ".tar")
+    epoch = ctx.attr.source_date_epoch
+    rpms = sorted(ctx.files.rpms, key = lambda f: f.path)
+    args = ctx.actions.args()
+    args.add(out)
+    args.add_all(rpms)
+    ctx.actions.run_shell(
+        inputs = rpms,
+        outputs = [out],
+        arguments = [args],
+        mnemonic = "RpmDb",
+        progress_message = "Recording %d RPMs in an RPM database for %s" % (len(rpms), ctx.label.name),
+        command = """set -euo pipefail
+out="$(pwd)/$1"; shift
+R=$(mktemp -d)
+trap 'rm -rf "$R"' EXIT
+export SOURCE_DATE_EPOCH={epoch}
+rpm --root "$R" --initdb
+rpm --root "$R" -i --justdb --nodeps --noscripts --notriggers --nosignature --nodigest --ignorearch --ignoreos "$@"
+test "$(rpm --root "$R" -qa | wc -l)" -eq "$#"
+# rollback-journal mode, so the image's non-root default user can read the database (a WAL database needs a writable
+# directory for its -shm file even to be read)
+python3 -c 'import sqlite3, sys; c = sqlite3.connect(sys.argv[1]); c.execute("PRAGMA journal_mode=DELETE"); c.close()' \
+    "$R/var/lib/rpm/rpmdb.sqlite"
+rm -f "$R/var/lib/rpm/rpmdb.sqlite-shm" "$R/var/lib/rpm/rpmdb.sqlite-wal" "$R/var/lib/rpm/.rpm.lock"
+chmod 0755 "$R/var" "$R/var/lib" "$R/var/lib/rpm"
+chmod 0644 "$R/var/lib/rpm/rpmdb.sqlite"
+tar --format=gnu --sort=name --no-recursion --numeric-owner --owner=0 --group=0 --mtime=@{epoch} \\
+    -C "$R" -cf "$out" var var/lib var/lib/rpm var/lib/rpm/rpmdb.sqlite
+""".format(epoch = epoch),
+    )
+    return [DefaultInfo(files = depset([out]))]
+
+rpmdb = rule(
+    implementation = _rpmdb_impl,
+    attrs = {
+        "rpms": attr.label_list(allow_files = True, mandatory = True),
+        "source_date_epoch": attr.string(mandatory = True),
+    },
+)
