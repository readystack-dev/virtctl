ReadyStack 0003: an RPM database in the virt-handler and virt-launcher images.

bazeldnf's rpm2tar writes the RPM payloads but no RPM database, so a scanner sees none of the ~118 (handler) and ~195
(launcher) CentOS Stream packages. //rpm/rpmdb records exactly the RPMs of each image's rpmtree (rpm --justdb, from
rpm/BUILD.bazel by gen_rpmdb.py; the handler set adds passt, whose passt-repair binary the image carries) in
/var/lib/rpm/rpmdb.sqlite, as one more layer. INSTALLTIME and INSTALLTID come from SOURCE_DATE_EPOCH. Metadata only.

--- a/cmd/virt-handler/BUILD.bazel
+++ b/cmd/virt-handler/BUILD.bazel
@@ -185,6 +185,7 @@
         ],
         "//conditions:default": [
             "//rpm:handlerbase_x86_64",
+            "//rpm/rpmdb:handler_x86_64_cs9",
             ":passwd-tar",
             ":nsswitch-tar",
             ":get-version-tar",
--- a/cmd/virt-launcher/BUILD.bazel
+++ b/cmd/virt-launcher/BUILD.bazel
@@ -240,6 +240,7 @@
         ],
         "//conditions:default": [
             "//rpm:launcherbase_x86_64",
+            "//rpm/rpmdb:launcher_x86_64_cs9",
             ":get-version-tar",
             ":libvirt-config",
             ":passwd-tar",
--- /dev/null
+++ b/rpm/rpmdb/BUILD.bazel
@@ -0,0 +1,333 @@
